  "audit_rules": [
    {
      "code": "PARSER_SCHEMA_CHANGED",
      "severity": "BLOCKED",
      "condition": "Cabeçalho/ordem/estrutura não bate com fingerprint homologado.",
      "action": "Não processar fonte; preservar snapshot anterior; revisar parser da fonte."
    },
    {
      "code": "PARSER_REQUIRED_COLUMN_MISSING",
      "severity": "BLOCKED",
      "condition": "Coluna obrigatória desapareceu.",
      "action": "Não processar fonte; informar coluna/posição esperada e encontrada."
    },
    {
      "code": "PARSER_TYPE_CHANGED",
      "severity": "BLOCKED",
      "condition": "Campo obrigatório mudou de tipo incompatível.",
      "action": "Não converter silenciosamente; revisar exportação/parser."
    },
    {
      "code": "MASTER_POPULATION_CHANGED",
      "severity": "WARNING/BLOCKED",
      "condition": "População controlada (ex.: RCA) mudou.",
      "action": "Mostrar adicionados/removidos/alterados e exigir revalidação quando configurado."
    },
    {
      "code": "AMBIGUOUS_RCA_CODE",
      "severity": "BLOCKED",
      "condition": "Mesmo código aparece como atual e legado de pessoas diferentes.",
      "action": "Resolver por vigência/contexto; nunca escolher por precedência."
    },
    {
      "code": "UNKNOWN_OPERATION_CFOP",
      "severity": "BLOCKED_DEPENDENT_CALC",
      "condition": "379 recebeu par Operação/CFOP não homologado.",
      "action": "Preservar fato como OTHER e bloquear cálculos que exigem classificação até homologar."
    },
    {
      "code": "INVALID_CNPJ",
      "severity": "WARNING/BLOCKED",
      "condition": "Documento declarado CNPJ não normaliza para 14 dígitos.",
      "action": "Preservar raw; excluir apenas do cálculo que exige CNPJ ou bloquear se chave obrigatória."
    },
    {
      "code": "INVALID_GTIN",
      "severity": "WARNING",
      "condition": "EAN/DUN não passa validação.",
      "action": "Preservar raw; não criar correspondência falsa."
    },
    {
      "code": "SOURCE_REJECTED_KEEP_PREVIOUS",
      "severity": "INFO",
      "condition": "Nova fonte foi rejeitada.",
      "action": "Snapshot válido anterior continua ativo; rejeição fica registrada."
    },
    {
      "code": "COMPETENCE_CLOSED",
      "severity": "INFO",
      "condition": "Competência encerrada manualmente.",
      "action": "Snapshot, auditoria, JSON e Excel ficam imutáveis."
    }
  ]
